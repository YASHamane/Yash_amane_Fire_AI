PY ?= python

.PHONY: all setup test bench parse-eval change report clean ui

all:
	cd project_a && $(MAKE) all

setup:
	cd project_a && $(MAKE) setup

test:
	cd project_a && $(MAKE) test

bench:
	cd project_a && $(MAKE) bench

parse-eval:
	cd project_a && $(MAKE) parse-eval

change:
	cd project_a && $(MAKE) change

report:
	cd project_a && $(MAKE) report

ui:
	cd project_a && $(MAKE) ui

clean:
	cd project_a && $(MAKE) clean
